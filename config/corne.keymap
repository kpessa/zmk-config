#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NUM 1
#define FN 2
#define STENO 3

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // both outer thumb keys together: steno on/off
        steno_toggle {
            timeout-ms = <50>;
            bindings = <&tog STENO>;
            key-positions = <36 41>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Kinesis";
            // Kinesis Advantage360 letter block and thumb order.
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | \ FN |
            // |ESC/CT|  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | SHFT |
            //                    | CMD | BSPC| DEL |   | ENT | SPC | ALT |
            //                          (hold DEL or ENT for the number/arrow layer)

            bindings = <
&kp TAB        &kp Q  &kp W  &kp E     &kp R     &kp T          &kp Y          &kp U      &kp I      &kp O    &kp P     &lt FN BSLH
&mt LCTRL ESC  &kp A  &kp S  &kp D     &kp F     &kp G          &kp H          &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT      &kp Z  &kp X  &kp C     &kp V     &kp B          &kp N          &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                             &kp LGUI  &kp BSPC  &lt NUM DEL    &lt NUM ENTER  &kp SPACE  &kp LALT
            >;
        };

        num_layer {
            display-name = "Num/Nav";
            // Kinesis number row moved down onto the top row, Kinesis bottom row
            // (` caps arrows brackets) on the bottom row, thumb-cluster nav keys in the middle.
            // -----------------------------------------------------------------------------------------
            // |  =   |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |  -   |
            // |      |     |     | HOME| END |     |   |     | PGUP| PGDN|     |     |      |
            // |      |  `  | CAPS| LFT | RGT |     |   |     |  UP | DWN |  [  |  ]  |      |

            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5    &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &kp MINUS
&trans     &none      &none     &kp HOME  &kp END    &none     &none   &kp PG_UP  &kp PG_DN  &none     &none     &trans
&trans     &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT  &none     &none   &kp UP     &kp DOWN   &kp LBKT  &kp RBKT  &trans
                                &trans    &trans     &trans    &trans  &trans     &trans
            >;
        };

        fn_layer {
            display-name = "Fn";
            // Hold the top-right key (\).
            // -----------------------------------------------------------------------------------------
            // | BOOT | BT1 | BT2 | BT3 | BT4 | BT5 |   | F1  | F2  | F3  | F4  | BOOT |     |
            // | BTCLR| USB/BT | RGB | STUDIO |     |     |   | F5  | F6  | F7  | F8  |      |     |
            // | RESET|     |     |     |     |     |   | F9  | F10 | F11 | F12 | RESET|     |

            bindings = <
&bootloader  &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4    &kp F1  &kp F2   &kp F3   &kp F4   &bootloader  &trans
&bt BT_CLR   &out OUT_TOG  &rgb_ug RGB_TOG  &studio_unlock  &none         &none           &kp F5  &kp F6   &kp F7   &kp F8   &none        &none
&sys_reset   &none         &none            &none           &none         &none           &kp F9  &kp F10  &kp F11  &kp F12  &sys_reset   &none
                                            &trans          &trans        &trans          &trans  &trans   &trans
            >;
        };

        steno_layer {
            display-name = "Steno";
            // Sends the keys Plover's "Keyboard" machine expects. Top row is the number bar.
            // -----------------------------------------------------------------------------------------
            // |  #   |  #  |  #  |  #  |  #  |  #  |   |  #  |  #  |  #  |  #  |  #  |  #   |
            // |      |  S  |  T  |  P  |  H  |  *  |   |  *  |  F  |  P  |  L  |  T  |  D   |
            // |      |  S  |  K  |  W  |  R  |  *  |   |  *  |  R  |  B  |  G  |  S  |  Z   |
            //                    |     |  A  |  O  |   |  E  |  U  |     |

            bindings = <
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6    &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS  &kp EQUAL
&none   &kp Q   &kp W   &kp E   &kp R   &kp T     &kp Y   &kp U   &kp I   &kp O   &kp P      &kp LBKT
&none   &kp A   &kp S   &kp D   &kp F   &kp G     &kp H   &kp J   &kp K   &kp L   &kp SEMI   &kp SQT
                        &none   &kp C   &kp V     &kp N   &kp M   &none
            >;
        };
    };
};

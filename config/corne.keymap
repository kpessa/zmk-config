#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NUM 1
#define SYM 2
#define FN 3
#define STENO 4
#define NAV 5
#define ROW 6
#define SROW 7
#define ROWS 8
#define LGATE 9

// Layer signals for the viewer app (viewer/): each layer has a consumer key that
// macOS ignores. Held layers keep theirs down for as long as they are held;
// locked layers (and the way back to base) tap theirs once.
#define SIG_BASE C_MEDIA_TV
#define SIG_NUM C_MEDIA_VCR
#define SIG_SYM C_MEDIA_TUNER
#define SIG_FN C_MEDIA_TAPE
#define SIG_STENO C_MEDIA_CABLE
#define SIG_NAV C_MEDIA_SATELLITE
#define SIG_ROW C_MEDIA_GAMES
#define SIG_SROW C_MEDIA_CD
#define SIG_ROWS C_MEDIA_GUIDE

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

/ {
    // Layer colours: every LED changes with the layer (white = typing).
    macros {
        num_c: num_colour {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &rgb_ug RGB_COLOR_HSB(240,100,25)>,
                       <&macro_press &mo NUM &kp SIG_NUM>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo NUM &kp SIG_NUM>,
                       <&macro_tap &rgb_ug RGB_COLOR_HSB(0,0,25)>;
        };

        sym_c: sym_colour {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &rgb_ug RGB_COLOR_HSB(30,100,25)>,
                       <&macro_press &mo SYM &kp SIG_SYM>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo SYM &kp SIG_SYM>,
                       <&macro_tap &rgb_ug RGB_COLOR_HSB(0,0,25)>;
        };

        // the top-row layers are reached from Num / Symbols, so they fall back to
        // that layer's colour
        row_c: row_colour {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &rgb_ug RGB_COLOR_HSB(60,100,25)>,
                       <&macro_press &mo ROW &kp SIG_ROW>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo ROW &kp SIG_ROW>,
                       <&macro_tap &rgb_ug RGB_COLOR_HSB(240,100,25)>;
        };

        srow_c: sym_row_colour {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &rgb_ug RGB_COLOR_HSB(330,100,25)>,
                       <&macro_press &mo SROW &kp SIG_SROW>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo SROW &kp SIG_SROW>,
                       <&macro_tap &rgb_ug RGB_COLOR_HSB(30,100,25)>;
        };

        // numbers over their symbols, held with two edge keys together (red)
        rows_c: rows_colour {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &rgb_ug RGB_COLOR_HSB(0,100,25)>,
                       <&macro_press &mo ROWS &kp SIG_ROWS>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo ROWS &kp SIG_ROWS>,
                       <&macro_tap &rgb_ug RGB_COLOR_HSB(0,0,25)>;
        };

        fn_c: fn_colour {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &rgb_ug RGB_COLOR_HSB(280,100,25)>,
                       <&macro_press &mo FN &kp SIG_FN>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo FN &kp SIG_FN>,
                       <&macro_tap &rgb_ug RGB_COLOR_HSB(0,0,25)>;
        };

        steno_on: steno_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(120,100,25)>, <&to STENO>, <&kp SIG_STENO>;
        };

        steno_off: steno_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(0,0,25)>, <&to BASE>, <&kp SIG_BASE>;
        };

        nav_on: nav_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(180,100,25)>, <&to NAV>, <&kp SIG_NAV>;
        };

        nav_off: nav_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(0,0,25)>, <&to BASE>, <&kp SIG_BASE>;
        };

        // same as num_c / sym_c / fn_c, but fall back to the NAV colour on release
        num_cn: num_colour_nav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &rgb_ug RGB_COLOR_HSB(240,100,25)>,
                       <&macro_press &mo NUM &kp SIG_NUM>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo NUM &kp SIG_NUM>,
                       <&macro_tap &rgb_ug RGB_COLOR_HSB(180,100,25)>;
        };

        sym_cn: sym_colour_nav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &rgb_ug RGB_COLOR_HSB(30,100,25)>,
                       <&macro_press &mo SYM &kp SIG_SYM>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo SYM &kp SIG_SYM>,
                       <&macro_tap &rgb_ug RGB_COLOR_HSB(180,100,25)>;
        };

        fn_cn: fn_colour_nav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &rgb_ug RGB_COLOR_HSB(280,100,25)>,
                       <&macro_press &mo FN &kp SIG_FN>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo FN &kp SIG_FN>,
                       <&macro_tap &rgb_ug RGB_COLOR_HSB(180,100,25)>;
        };

        // lights on, solid, white: use if the colours ever get out of step
        rgb_reset: rgb_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_ON>, <&rgb_ug RGB_EFS_CMD 0>, <&rgb_ug RGB_COLOR_HSB(0,0,25)>;
        };
    };

    behaviors {
        // Left shift: shift as usual, and while it is down esc opens Rows instead
        // (the LGate layer). So hold shift first, then esc, and keep both down.
        lsft_gate: left_shift_gate {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &kp LSHFT &mo LGATE>,
                       <&macro_pause_for_release>,
                       <&macro_release &kp LSHFT &mo LGATE>;
        };

        // The Rows number row: shift is still held when Rows is reached through left
        // shift, so these drop it and always type the plain number.
#define UNSHIFTED(name, key) name: name { compatible = "zmk,behavior-mod-morph"; \
            #binding-cells = <0>; bindings = <&kp key>, <&kp key>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        UNSHIFTED(us_N1, N1) UNSHIFTED(us_N2, N2) UNSHIFTED(us_N3, N3) UNSHIFTED(us_N4, N4)
        UNSHIFTED(us_N5, N5) UNSHIFTED(us_N6, N6) UNSHIFTED(us_N7, N7) UNSHIFTED(us_N8, N8)
        UNSHIFTED(us_N9, N9) UNSHIFTED(us_N0, N0) UNSHIFTED(us_EQUAL, EQUAL) UNSHIFTED(us_MINUS, MINUS)

        // The Rows arrows drop only left shift (the one lsft_gate holds), so right shift +
        // arrows still selects.
#define UNSHIFTED_L(name, key) name: name { compatible = "zmk,behavior-mod-morph"; \
            #binding-cells = <0>; bindings = <&kp key>, <&kp key>; mods = <(MOD_LSFT)>; };
        UNSHIFTED_L(us_UP, UP) UNSHIFTED_L(us_DOWN, DOWN) UNSHIFTED_L(us_LEFT, LEFT) UNSHIFTED_L(us_RIGHT, RIGHT)

        // tap = key, hold = NUM layer (blue)
        ltn: layer_tap_num {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&num_c>, <&kp>;
        };

        ltnn: layer_tap_num_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&num_cn>, <&kp>;
        };

        // tap = key, hold = SYM layer (orange)
        lts: layer_tap_sym {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&sym_c>, <&kp>;
        };

        ltsn: layer_tap_sym_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&sym_cn>, <&kp>;
        };

        // tap = key, hold = number row (yellow) / symbol row (pink)
        ltr: layer_tap_row {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&row_c>, <&kp>;
        };

        ltsr: layer_tap_sym_row {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&srow_c>, <&kp>;
        };

        ltfn: layer_tap_fn_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&fn_cn>, <&kp>;
        };

        // tap = key, hold = Rows (red): the top-left Tab, mirroring Fn on the top right
        ltrows: layer_tap_rows {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&rows_c>, <&kp>;
        };

        // tap = key, hold = FN layer (purple)
        ltf: layer_tap_fn {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&fn_c>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // both inner thumb keys together: steno on (green) / off (white)
        steno_enter {
            timeout-ms = <50>;
            bindings = <&steno_on>;
            key-positions = <38 39>;
            layers = <BASE>;
        };

        // both outer thumb keys together: arrows layer on (cyan) / off (white)
        nav_enter {
            timeout-ms = <50>;
            bindings = <&nav_on>;
            key-positions = <36 41>;
            layers = <BASE>;
        };

        nav_exit {
            timeout-ms = <50>;
            bindings = <&nav_off>;
            key-positions = <36 41>;
            layers = <NAV>;
        };

        steno_exit {
            timeout-ms = <50>;
            bindings = <&steno_off>;
            key-positions = <38 39>;
            layers = <STENO>;
        };

        // Parentheses from the home row, no layer and no thumb: D + F together is (,
        // J + K together is ). (They are still on Symbols too.) The idle time keeps a
        // fast roll through d-f or j-k in a word from firing them.
        paren_open {
            timeout-ms = <40>;
            require-prior-idle-ms = <75>;
            bindings = <&kp LPAR>;
            key-positions = <15 16>;
            layers = <BASE NAV>;
        };

        paren_close {
            timeout-ms = <40>;
            require-prior-idle-ms = <75>;
            bindings = <&kp RPAR>;
            key-positions = <19 20>;
            layers = <BASE NAV>;
        };

        // A + S together is !, L + ; together is -. "as" is a common pair of letters to
        // roll through, so these have to land closer together than the parentheses do.
        exclaim {
            timeout-ms = <25>;
            require-prior-idle-ms = <75>;
            bindings = <&kp EXCL>;
            key-positions = <13 14>;
            layers = <BASE NAV>;
        };

        dash {
            timeout-ms = <25>;
            require-prior-idle-ms = <75>;
            bindings = <&kp MINUS>;
            key-positions = <21 22>;
            layers = <BASE NAV>;
        };

        // F + G together is left arrow, H + J together is right arrow: the two index
        // fingers reaching in. Held, they repeat; with shift or option they select or
        // move by word as the arrow keys do.
        arrow_left {
            timeout-ms = <40>;
            require-prior-idle-ms = <75>;
            bindings = <&kp LEFT>;
            key-positions = <16 17>;
            layers = <BASE NAV>;
        };

        arrow_right {
            timeout-ms = <40>;
            require-prior-idle-ms = <75>;
            bindings = <&kp RIGHT>;
            key-positions = <18 19>;
            layers = <BASE NAV>;
        };

        // The two outer keys of the home and bottom rows held together, on either edge
        // (esc + left shift, or ' + right shift): the Rows layer for as long as both
        // are down. On the left, shift first and esc after also works (lsft_gate); the
        // right side stays a together-only chord because right shift then ' is ".
        rows_left {
            timeout-ms = <50>;
            bindings = <&rows_c>;
            key-positions = <12 24>;
            layers = <BASE>;
        };

        rows_right {
            timeout-ms = <50>;
            bindings = <&rows_c>;
            key-positions = <23 35>;
            layers = <BASE>;
        };

        // The three keys under the arrows' up, left and right ( ; . and right shift)
        // together: arrows layer on / off, the same as both outer thumbs.
        nav_enter_cluster {
            timeout-ms = <50>;
            bindings = <&nav_on>;
            key-positions = <22 33 35>;
            layers = <BASE>;
        };

        nav_exit_cluster {
            timeout-ms = <50>;
            bindings = <&nav_off>;
            key-positions = <22 33 35>;
            layers = <NAV>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Kinesis";
            // Kinesis Advantage360 letter block and thumb order.
            // -----------------------------------------------------------------------------------------
            // |TAB/RW|  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | \ FN |
            // |ESC/CT|  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | SHFT |
            //                    | CMD | BSPC| DEL |   | ENT | SPC | ALT |
            //                          (hold DEL for numbers, ENT for their symbols)
            // LEDs: white here, blue on Num/Nav, orange on Symbols, purple on Fn, green on Steno

            bindings = <
&ltrows 0 TAB  &kp Q  &kp W  &kp E     &kp R     &kp T          &kp Y          &kp U      &kp I      &kp O    &kp P     &ltf 0 BSLH
&mt LCTRL ESC  &kp A  &kp S  &kp D     &kp F     &kp G          &kp H          &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&lsft_gate     &kp Z  &kp X  &kp C     &kp V     &kp B          &kp N          &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                             &kp LGUI  &kp BSPC  &ltn 0 DEL    &lts 0 ENTER  &kp SPACE  &kp LALT
            >;
        };

        num_layer {
            display-name = "Num/Nav";
            // Numpad under the right hand, reading 1 2 3 from the top; arrow cluster under the left.
            // -----------------------------------------------------------------------------------------
            // |      |     | HOME|  UP | END | PGUP|   |  /  |  1  |  2  |  3  |  -  |  =   |
            // |      |     | LFT | DWN | RGT | PGDN|   |  0  |  4  |  5  |  6  |  .  |      |
            // |      |  `  | CAPS|  [  |  ]  |     |   |  ;  |  7  |  8  |  9  |  ,  |      |
            //                          (also hold SPC for the number row across the top)

            bindings = <
&trans  &none      &kp HOME  &kp UP    &kp END    &kp PG_UP    &kp FSLH  &kp N1  &kp N2  &kp N3  &kp MINUS  &kp EQUAL
&trans  &none      &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN    &kp N0    &kp N4  &kp N5  &kp N6  &kp DOT    &trans
&trans  &kp GRAVE  &kp CAPS  &kp LBKT  &kp RBKT   &none        &kp SEMI  &kp N7  &kp N8  &kp N9  &kp COMMA  &trans
                             &trans    &trans     &trans       &trans    &ltr 0 SPACE  &trans
            >;
        };

        sym_layer {
            display-name = "Symbols";
            // Right hand: the Num layer with shift already held, same positions.
            // Left hand: the bracket pairs, opposite the thumb that holds the layer.
            // -----------------------------------------------------------------------------------------
            // Far left: Mission Control over desktop left / right (Ctrl + arrows).
            // |      |     | MCTL|  [  |  ]  |     |   |  ?  |  !  |  @  |  #  |  _  |  +   |
            // |      | DSK<| DSK>|  (  |  )  |     |   |  )  |  $  |  %  |  ^  |  >  |      |
            // |      |  ~  |     |  {  |  }  |     |   |  :  |  &  |  *  |  (  |  <  |      |
            //                          (also hold BSPC for the symbol row across the top)

            bindings = <
&trans  &none         &kp LC(UP)     &kp LBKT  &kp RBKT  &none    &kp QMARK  &kp EXCL  &kp AT     &kp HASH   &kp UNDER  &kp PLUS
&trans  &kp LC(LEFT)  &kp LC(RIGHT)  &kp LPAR  &kp RPAR  &none    &kp RPAR   &kp DLLR  &kp PRCNT  &kp CARET  &kp GT     &trans
&trans  &kp TILDE      &none          &kp LBRC  &kp RBRC  &none    &kp COLON  &kp AMPS  &kp STAR   &kp LPAR   &kp LT     &trans
                             &trans    &ltsr 0 BSPC  &trans    &trans     &trans    &trans
            >;
        };

        fn_layer {
            display-name = "Fn";
            // Hold the top-right key (\).
            // -----------------------------------------------------------------------------------------
            // | BOOT | BT1 | BT2 | BT3 | BT4 | BT5 |   | F1  | F2  | F3  | F4  | BOOT |     |
            // | BTCLR| USB/BT | RGB | STUDIO | RGB RESET | DICTATE |   | F5  | F6  | F7  | F8  |      |     |
            // | RESET|     |     |     |     |     |   | F9  | F10 | F11 | F12 | RESET|     |

            bindings = <
&bootloader  &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4    &kp F1  &kp F2   &kp F3   &kp F4   &bootloader  &trans
&bt BT_CLR   &out OUT_TOG  &rgb_ug RGB_TOG  &studio_unlock  &rgb_reset    &kp LC(LA(LS(LG(D))))           &kp F5  &kp F6   &kp F7   &kp F8   &none        &none
&sys_reset   &none         &none            &none           &none         &none           &kp F9  &kp F10  &kp F11  &kp F12  &sys_reset   &none
                                            &trans          &trans        &trans          &trans  &trans   &trans
            >;
        };

        steno_layer {
            display-name = "Steno";
            // Sends the keys Plover's "Keyboard" machine expects. Top row is the number bar.
            // -----------------------------------------------------------------------------------------
            // |  #   |  #  |  #  |  #  |  #  |  #  |   |  #  |  #  |  #  |  #  |  #  |  #   |
            // |      |  S  |  T  |  P  |  H  |  *  |   |  *  |  F  |  P  |  L  |  T  |  D   |
            // |      |  S  |  K  |  W  |  R  |  *  |   |  *  |  R  |  B  |  G  |  S  |  Z   |
            //                    |  A  |  O  |     |   |     |  E  |  U  |

            bindings = <
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6    &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS  &kp EQUAL
&none   &kp Q   &kp W   &kp E   &kp R   &kp T     &kp Y   &kp U   &kp I   &kp O   &kp P      &kp LBKT
&none   &kp A   &kp S   &kp D   &kp F   &kp G     &kp H   &kp J   &kp K   &kp L   &kp SEMI   &kp SQT
                        &kp C   &kp V   &none     &none   &kp N   &kp M
            >;
        };

        nav_layer {
            display-name = "Arrows";
            // Locks on. Typing still works; the bottom-right corner becomes an arrow
            // cluster and the left edge is Option / Ctrl / Shift for word moves and selection.
            // -----------------------------------------------------------------------------------------
            // | OPT  |     |     |     |     |     |   |     |     |     |     |     |      |
            // | CTRL |     |     |     |     |     |   |     |     |     |     |  UP |      |
            // | SHFT |     |     |     |     |     |   |     |     |     | LFT | DWN | RGT  |

            bindings = <
&kp LALT   &trans  &trans  &trans  &trans  &trans         &trans           &trans  &trans  &trans    &trans    &ltfn 0 BSLH
&kp LCTRL  &trans  &trans  &trans  &trans  &trans         &trans           &trans  &trans  &trans    &kp UP    &trans
&kp LSHFT  &trans  &trans  &trans  &trans  &trans         &trans           &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT
                           &trans  &trans  &ltnn 0 DEL    &ltsn 0 ENTER    &trans  &trans
            >;
        };

        row_layer {
            display-name = "NumRow";
            // Hold DEL (Num), then SPC. Just the classic number row.
            // -----------------------------------------------------------------------------------------
            // |  =   |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |  -   |

            bindings = <
&kp EQUAL  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS
&trans     &none   &none   &none   &none   &none     &none   &none   &none   &none   &none   &trans
&trans     &none   &none   &none   &none   &none     &none   &none   &none   &none   &none   &trans
                           &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        sym_row_layer {
            display-name = "SymRow";
            // Hold ENT (Symbols), then BSPC. The number row's symbols, in the same places.
            // -----------------------------------------------------------------------------------------
            // |  +   |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |  _   |

            bindings = <
&kp PLUS  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp UNDER
&trans    &none     &none   &none     &none     &none        &none      &none     &none     &none     &none     &trans
&trans    &none     &none   &none     &none     &none        &none      &none     &none     &none     &none     &trans
                            &trans    &trans    &trans       &trans     &trans    &trans
            >;
        };

        rows_layer {
            display-name = "Rows";
            // Hold TAB (top left), or left SHIFT then ESC (or both together), or ' + right SHIFT together. The number row, with each
            // number's symbol on the home row under it, as on a full keyboard.
            // -----------------------------------------------------------------------------------------
            // |  =   |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |  -   |
            // |  +   |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |  _   |
            // |      |     |     |     |     |     |   |  ↑  |     |     |     |     |      |
            //                          |     |     |   |  ←  |  ↓  |  →  |
            // (+ sits under the left pair and _ under the right pair, so each is only
            //  reachable when holding the other edge. Arrows: ↑ on N, ← ↓ → on the right
            //  thumbs, an upside-down T.)

            bindings = <
&us_EQUAL  &us_N1    &us_N2  &us_N3    &us_N4    &us_N5       &us_N6     &us_N7    &us_N8    &us_N9    &us_N0    &us_MINUS
&kp PLUS   &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp UNDER
&trans     &none     &none   &none     &none     &none        &us_UP     &none     &none     &none     &none     &trans
                             &trans    &trans    &trans       &us_LEFT   &us_DOWN  &us_RIGHT
            >;
        };

        lgate_layer {
            display-name = "LGate";
            // Not a layer you see: on while left shift is held, so esc opens Rows.
            // Everything else passes through (shift itself is held by lsft_gate).
            bindings = <
&trans   &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&rows_c  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                         &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};

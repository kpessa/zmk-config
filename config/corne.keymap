#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NUM 1
#define SYM 2
#define FN 3
#define STENO 4
#define NAV 5

// Layer signals for the viewer app (viewer/): every layer change also taps a
// consumer key that macOS ignores, so the app can follow the active layer.
#define SIG_BASE C_MEDIA_TV
#define SIG_NUM C_MEDIA_VCR
#define SIG_SYM C_MEDIA_TUNER
#define SIG_FN C_MEDIA_TAPE
#define SIG_STENO C_MEDIA_CABLE
#define SIG_NAV C_MEDIA_SATELLITE

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

/ {
    // Layer colours: every LED changes with the layer (white = typing).
    macros {
        num_c: num_colour {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &rgb_ug RGB_COLOR_HSB(240,100,25)>,
                       <&macro_press &mo NUM>,
                       <&macro_tap &kp SIG_NUM>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo NUM>,
                       <&macro_tap &rgb_ug RGB_COLOR_HSB(0,0,25) &kp SIG_BASE>;
        };

        sym_c: sym_colour {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &rgb_ug RGB_COLOR_HSB(30,100,25)>,
                       <&macro_press &mo SYM>,
                       <&macro_tap &kp SIG_SYM>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo SYM>,
                       <&macro_tap &rgb_ug RGB_COLOR_HSB(0,0,25) &kp SIG_BASE>;
        };

        fn_c: fn_colour {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &rgb_ug RGB_COLOR_HSB(280,100,25)>,
                       <&macro_press &mo FN>,
                       <&macro_tap &kp SIG_FN>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo FN>,
                       <&macro_tap &rgb_ug RGB_COLOR_HSB(0,0,25) &kp SIG_BASE>;
        };

        steno_on: steno_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(120,100,25)>, <&to STENO>, <&kp SIG_STENO>;
        };

        steno_off: steno_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(0,0,25)>, <&to BASE>, <&kp SIG_BASE>;
        };

        nav_on: nav_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(180,100,25)>, <&to NAV>, <&kp SIG_NAV>;
        };

        nav_off: nav_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_COLOR_HSB(0,0,25)>, <&to BASE>, <&kp SIG_BASE>;
        };

        // same as num_c / sym_c / fn_c, but fall back to the NAV colour on release
        num_cn: num_colour_nav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &rgb_ug RGB_COLOR_HSB(240,100,25)>,
                       <&macro_press &mo NUM>,
                       <&macro_tap &kp SIG_NUM>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo NUM>,
                       <&macro_tap &rgb_ug RGB_COLOR_HSB(180,100,25) &kp SIG_NAV>;
        };

        sym_cn: sym_colour_nav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &rgb_ug RGB_COLOR_HSB(30,100,25)>,
                       <&macro_press &mo SYM>,
                       <&macro_tap &kp SIG_SYM>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo SYM>,
                       <&macro_tap &rgb_ug RGB_COLOR_HSB(180,100,25) &kp SIG_NAV>;
        };

        fn_cn: fn_colour_nav {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &rgb_ug RGB_COLOR_HSB(280,100,25)>,
                       <&macro_press &mo FN>,
                       <&macro_tap &kp SIG_FN>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo FN>,
                       <&macro_tap &rgb_ug RGB_COLOR_HSB(180,100,25) &kp SIG_NAV>;
        };

        // lights on, solid, white: use if the colours ever get out of step
        rgb_reset: rgb_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_ON>, <&rgb_ug RGB_EFS_CMD 0>, <&rgb_ug RGB_COLOR_HSB(0,0,25)>;
        };
    };

    behaviors {
        // tap = key, hold = NUM layer (blue)
        ltn: layer_tap_num {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&num_c>, <&kp>;
        };

        ltnn: layer_tap_num_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&num_cn>, <&kp>;
        };

        // tap = key, hold = SYM layer (orange)
        lts: layer_tap_sym {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&sym_c>, <&kp>;
        };

        ltsn: layer_tap_sym_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&sym_cn>, <&kp>;
        };

        ltfn: layer_tap_fn_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&fn_cn>, <&kp>;
        };

        // tap = key, hold = FN layer (purple)
        ltf: layer_tap_fn {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&fn_c>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // both inner thumb keys together: steno on (green) / off (white)
        steno_enter {
            timeout-ms = <50>;
            bindings = <&steno_on>;
            key-positions = <38 39>;
            layers = <BASE>;
        };

        // both outer thumb keys together: arrows layer on (cyan) / off (white)
        nav_enter {
            timeout-ms = <50>;
            bindings = <&nav_on>;
            key-positions = <36 41>;
            layers = <BASE>;
        };

        nav_exit {
            timeout-ms = <50>;
            bindings = <&nav_off>;
            key-positions = <36 41>;
            layers = <NAV>;
        };

        steno_exit {
            timeout-ms = <50>;
            bindings = <&steno_off>;
            key-positions = <38 39>;
            layers = <STENO>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Kinesis";
            // Kinesis Advantage360 letter block and thumb order.
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | \ FN |
            // |ESC/CT|  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | SHFT |
            //                    | CMD | BSPC| DEL |   | ENT | SPC | ALT |
            //                          (hold DEL for numbers, ENT for their symbols)
            // LEDs: white here, blue on Num/Nav, orange on Symbols, purple on Fn, green on Steno

            bindings = <
&kp TAB        &kp Q  &kp W  &kp E     &kp R     &kp T          &kp Y          &kp U      &kp I      &kp O    &kp P     &ltf 0 BSLH
&mt LCTRL ESC  &kp A  &kp S  &kp D     &kp F     &kp G          &kp H          &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT      &kp Z  &kp X  &kp C     &kp V     &kp B          &kp N          &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                             &kp LGUI  &kp BSPC  &ltn 0 DEL    &lts 0 ENTER  &kp SPACE  &kp LALT
            >;
        };

        num_layer {
            display-name = "Num/Nav";
            // Kinesis number row moved down onto the top row, Kinesis bottom row
            // (` caps arrows brackets) on the bottom row, thumb-cluster nav keys in the middle.
            // -----------------------------------------------------------------------------------------
            // |  =   |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |  -   |
            // |      |     |     | HOME| END |     |   |     | PGUP| PGDN|     |     |      |
            // |      |  `  | CAPS| LFT | RGT |     |   |     |  UP | DWN |  [  |  ]  |      |

            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5    &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &kp MINUS
&trans     &none      &none     &kp HOME  &kp END    &none     &none   &kp PG_UP  &kp PG_DN  &none     &none     &trans
&trans     &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT  &none     &none   &kp UP     &kp DOWN   &kp LBKT  &kp RBKT  &trans
                                &trans    &trans     &trans    &trans  &trans     &trans
            >;
        };

        sym_layer {
            display-name = "Symbols";
            // The Num layer with shift already held: same positions, no shift needed.
            // Nav keys are the same as on Num, so they work under either thumb.
            // -----------------------------------------------------------------------------------------
            // |  +   |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |  _   |
            // |      |     |     | HOME| END |     |   |     | PGUP| PGDN|     |     |      |
            // |      |  ~  | CAPS| LFT | RGT |     |   |     |  UP | DWN |  {  |  }  |      |

            bindings = <
&kp PLUS   &kp EXCL   &kp AT    &kp HASH  &kp DLLR   &kp PRCNT  &kp CARET  &kp AMPS   &kp STAR   &kp LPAR  &kp RPAR  &kp UNDER
&trans     &none      &none     &kp HOME  &kp END    &none      &none      &kp PG_UP  &kp PG_DN  &none     &none     &trans
&trans     &kp TILDE  &kp CAPS  &kp LEFT  &kp RIGHT  &none      &none      &kp UP     &kp DOWN   &kp LBRC  &kp RBRC  &trans
                                &trans    &trans     &trans     &trans     &trans     &trans
            >;
        };

        fn_layer {
            display-name = "Fn";
            // Hold the top-right key (\).
            // -----------------------------------------------------------------------------------------
            // | BOOT | BT1 | BT2 | BT3 | BT4 | BT5 |   | F1  | F2  | F3  | F4  | BOOT |     |
            // | BTCLR| USB/BT | RGB | STUDIO | RGB RESET |     |   | F5  | F6  | F7  | F8  |      |     |
            // | RESET|     |     |     |     |     |   | F9  | F10 | F11 | F12 | RESET|     |

            bindings = <
&bootloader  &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4    &kp F1  &kp F2   &kp F3   &kp F4   &bootloader  &trans
&bt BT_CLR   &out OUT_TOG  &rgb_ug RGB_TOG  &studio_unlock  &rgb_reset    &none           &kp F5  &kp F6   &kp F7   &kp F8   &none        &none
&sys_reset   &none         &none            &none           &none         &none           &kp F9  &kp F10  &kp F11  &kp F12  &sys_reset   &none
                                            &trans          &trans        &trans          &trans  &trans   &trans
            >;
        };

        steno_layer {
            display-name = "Steno";
            // Sends the keys Plover's "Keyboard" machine expects. Top row is the number bar.
            // -----------------------------------------------------------------------------------------
            // |  #   |  #  |  #  |  #  |  #  |  #  |   |  #  |  #  |  #  |  #  |  #  |  #   |
            // |      |  S  |  T  |  P  |  H  |  *  |   |  *  |  F  |  P  |  L  |  T  |  D   |
            // |      |  S  |  K  |  W  |  R  |  *  |   |  *  |  R  |  B  |  G  |  S  |  Z   |
            //                    |  A  |  O  |     |   |     |  E  |  U  |

            bindings = <
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6    &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS  &kp EQUAL
&none   &kp Q   &kp W   &kp E   &kp R   &kp T     &kp Y   &kp U   &kp I   &kp O   &kp P      &kp LBKT
&none   &kp A   &kp S   &kp D   &kp F   &kp G     &kp H   &kp J   &kp K   &kp L   &kp SEMI   &kp SQT
                        &kp C   &kp V   &none     &none   &kp N   &kp M
            >;
        };

        nav_layer {
            display-name = "Arrows";
            // Locks on. Typing still works; the bottom-right corner becomes an arrow
            // cluster and the left edge is Option / Ctrl / Shift for word moves and selection.
            // -----------------------------------------------------------------------------------------
            // | OPT  |     |     |     |     |     |   |     |     |     |     |     |      |
            // | CTRL |     |     |     |     |     |   |     |     |     |     |  UP |      |
            // | SHFT |     |     |     |     |     |   |     |     |     | LFT | DWN | RGT  |

            bindings = <
&kp LALT   &trans  &trans  &trans  &trans  &trans         &trans           &trans  &trans  &trans    &trans    &ltfn 0 BSLH
&kp LCTRL  &trans  &trans  &trans  &trans  &trans         &trans           &trans  &trans  &trans    &kp UP    &trans
&kp LSHFT  &trans  &trans  &trans  &trans  &trans         &trans           &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT
                           &trans  &trans  &ltnn 0 DEL    &ltsn 0 ENTER    &trans  &trans
            >;
        };
    };
};
